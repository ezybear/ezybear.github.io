{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "client": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "stack": {
      "type": "string"
    },
    "year": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "summary": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "link": {
      "type": "string"
    },
    "repo": {
      "type": "string"
    },
    "images": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "order": {
      "default": 999,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "client",
    "type",
    "stack",
    "year",
    "summary",
    "images"
  ]
}