---
import { Image } from "astro:assets";

const { project, eager = false } = Astro.props;
---

<a href={`/projects/${project.slug}`} class="group block space-y-4" data-project-card>
  <div class="aspect-[4/5] overflow-hidden rounded-[min(1vw,12px)] bg-paper">
    <Image
      src={project.images[0]}
      alt={`${project.title} — ${project.summary}`}
      width={1024}
      height={1280}
      loading={eager ? "eager" : "lazy"}
      decoding={eager ? "sync" : "async"}
      format="webp"
      class="h-full w-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-[1.03]"
    />
  </div>
  <div class="flex items-start justify-between gap-4">
    <div>
      <h2 class="text-sm font-medium">{project.title}</h2>
      <p class="text-xs text-faded">{project.summary}</p>
    </div>
    <span class="text-sm uppercase tracking-[0.2em] text-faded">July {project.year}</span>
  </div>
</a>
