---
import { Image } from "astro:assets";
import ProjectCard from "@/components/ProductCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import heroImg from "@/assets/minecraft-house-preview.png";
import { getProjects } from "@/data/projects.js";

const projects = await getProjects();
const featured = projects.filter((project) => project.featured).slice(0, 3);
const highlight = projects.find((project) => project.featured);

if (!highlight) {
  throw new Error("Missing featured project");
}
---

<BaseLayout
  title="Ezybear — Front-end developer portfolio"
  description="I create polished, accessible web experiences with Astro, TypeScript, and thoughtful design systems."
  image={heroImg}
>
  <main id="main-content">
    <h1 class="sr-only">Ezybear — portfolio and selected project case studies</h1>
    <section class="relative overflow-hidden bg-base">
      <div class="md:hidden">
        <div class="aspect-[4/3] w-full">
          <Image
            src={heroImg}
            alt="A calm editorial landing experience with thoughtful typography"
            width={1600}
            height={1280}
            format="webp"
            loading="eager"
            decoding="sync"
            class="h-full w-full object-cover object-right"
          />
        </div>
        <div class="space-y-6 px-6 py-12">
          <p class="flex items-center gap-3 text-[11px] uppercase tracking-[0.3em] text-faded">
            <span class="inline-block h-px w-8 bg-ink/40"></span>
            Student · Korean & Australian · Curious builder
          </p>
          <p class="text-balance font-serif text-4xl leading-[0.95]">
            I’m Ezra — a student who loves
            <br />
            <span class="italic text-accent">learning, building, and creating.</span>
          </p>
          <p class="max-w-[48ch] text-pretty leading-relaxed text-faded">
            I enjoy coding, reading, and turning ideas into real projects. Learn more about who I am and what I’m exploring.
          </p>
          <div class="flex flex-col items-start gap-4 pt-2 sm:flex-row sm:items-center">
            <a href="/projects" class="group inline-flex items-center gap-3 rounded-full bg-ink px-7 py-4 text-[11px] font-medium uppercase tracking-[0.2em] text-[var(--color-base)] transition-colors hover:bg-accent">
              View selected work
              <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
            </a>
            <a href="/about" class="text-[11px] uppercase tracking-[0.2em] text-faded transition-colors hover:text-ink">
              Learn about me →
            </a>
          </div>
        </div>
      </div>

      <div class="relative hidden h-[88vh] max-h-[920px] min-h-[640px] w-full md:block">
        <Image
          src={heroImg}
          alt="A calm editorial landing experience with thoughtful typography"
          width={1600}
          height={1280}
          format="webp"
          loading="eager"
          decoding="sync"
          class="absolute inset-0 h-full w-full object-cover object-right"
        />
        <div class="absolute inset-0" style="background: linear-gradient(90deg, var(--color-base) 0%, var(--color-base) 30%, color-mix(in oklab, var(--color-base) 55%, transparent) 45%, color-mix(in oklab, var(--color-base) 5%, transparent) 65%, transparent 80%)"></div>
        <div class="absolute inset-x-0 bottom-0 h-40" style="background: linear-gradient(180deg, transparent, var(--color-base))"></div>
        <div class="relative mx-auto flex h-full max-w-screen-xl items-center px-6">
          <div class="max-w-[480px] space-y-8">
            <p class="flex items-center gap-3 text-[11px] uppercase tracking-[0.3em] text-faded">
              <span class="inline-block h-px w-8 bg-ink/40"></span>
              Student · Korean & Australian · Curious builder
            </p>
            <p class="text-balance font-serif text-5xl leading-[0.95] lg:text-6xl">
              I’m Ezra — a student who loves
              <br />
              <span class="italic text-accent">learning, building, and creating.</span>
            </p>
            <p class="max-w-[48ch] text-pretty leading-relaxed text-faded md:text-lg">
              I enjoy coding, reading, and turning ideas into real projects. Learn more about who I am and what I’m exploring.
            </p>
            <div class="flex items-center gap-6 pt-2">
              <a href="/projects" class="group inline-flex items-center gap-3 rounded-full bg-ink px-7 py-4 text-[11px] font-medium uppercase tracking-[0.2em] text-[var(--color-base)] transition-colors hover:bg-accent">
                View selected work
                <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
              </a>
              <a href="/about" class="text-[11px] uppercase tracking-[0.2em] text-faded transition-colors hover:text-ink">
                Learn about me →
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-screen-xl px-6 pt-24 md:pt-32">
      <div class="mb-12 flex items-end justify-between gap-6 border-t border-line pt-10">
        <div>
          <p class="mb-4 text-[11px] uppercase tracking-[0.3em] text-faded">Featured work</p>
          <h2 class="max-w-[20ch] text-balance font-serif text-3xl md:text-5xl">
            Selected projects, <span class="italic text-accent">shaped for impact.</span>
          </h2>
        </div>
        <a href="/projects" class="hidden items-center gap-2 whitespace-nowrap text-[11px] uppercase tracking-[0.2em] text-faded transition-colors hover:text-ink md:inline-flex">
          View all
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 gap-x-8 gap-y-12 md:grid-cols-3">
        {featured.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>

  </main>
</BaseLayout>
