---
import ProjectDetailContent from "@/components/ProjectDetailContent.astro";
import { getProjects, getRelated } from "@/data/projects.js";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project, related: getRelated(projects, project.slug) },
  }));
}

const { project, related } = Astro.props;
---

<ProjectDetailContent project={project} related={related} />
