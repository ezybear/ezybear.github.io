---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import handsImg from "@/assets/atelier-hands.jpg";
import workshopImg from "@/assets/atelier-workshop.jpg";
---

<BaseLayout
  title="About — Ezybear"
  description="I am a front-end developer focused on accessible, high-performance interfaces and thoughtful product design."
  image={workshopImg}
>
  <main id="main-content">
    <section class="mx-auto max-w-screen-xl px-6 pb-16 pt-20 md:pb-24 md:pt-28">
      <p class="mb-6 flex items-center gap-3 text-[11px] uppercase tracking-[0.3em] text-faded">
        <span class="inline-block h-px w-8 bg-ink/40"></span>
        About me
      </p>
      <h1 class="max-w-[20ch] text-balance font-serif text-5xl leading-[0.95] md:text-7xl">
        I’m Ezra — a curious student who enjoys <span class="italic text-accent">learning, building, and trying new things.</span>
      </h1>
      <p class="mt-8 max-w-[68ch] text-lg leading-relaxed text-faded">
        My name is Ezra, and I was born in 2015. I am both Korean and Australian, and I enjoy learning in many different ways.
      </p>
      <p class="mt-6 max-w-[68ch] text-lg leading-relaxed text-faded">
        I enjoy coding because I like the feeling of starting with an idea and seeing it work. I also like reading, and I can read about two thick books in a day when I really get into them. I like running, basketball, piano, ballet, Chinese, and I also enjoy Minecraft and LEGO.
      </p>
    </section>

  </main>
</BaseLayout>
